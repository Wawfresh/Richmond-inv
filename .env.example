# ==============================================================================
# RICHMOND-INV Environment Configuration
# ==============================================================================
# Copy this file to `.env` (keep outside `public_html/` in production, chmod 600).
# Never commit real credentials or `.env` to GitHub.

# --- 1. Application & Domain --------------------------------------------------
NODE_ENV="production"
PORT="3000"
APP_URL="https://yourdomain.com"
CORS_ORIGIN="https://yourdomain.com"
# Set SERVE_STATIC="false" when Apache public_html serves dist/ and cPanel Node
# is mounted at /api. Set "true" if Node serves both frontend and /api on /.
SERVE_STATIC="false"

# --- 2. Database (Namecheap Stellar MySQL/MariaDB vs Local SQLite) ------------
# Leave DB_HOST empty locally to use embedded SQLite fallback.
# On Namecheap Stellar, set DB_CLIENT="mysql2" and DB_HOST="localhost".
DB_CLIENT="mysql2"
DB_HOST=""
DB_PORT="3306"
DB_NAME="cpaneluser_richmond_inv"
DB_USER="cpaneluser_richmond_user"
DB_PASSWORD="CHANGE_ME_STRONG_DB_PASSWORD"
DB_POOL_MAX="8"
SQLITE_PATH="./storage/richmond_inv_local.sqlite"

# --- 3. Sessions, Cookies & Security ------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET="CHANGE_ME_64_BYTE_RANDOM_HEX_SECRET"
COOKIE_SECURE="true"
# Use "lax" when frontend and /api share https://yourdomain.com in production.
COOKIE_SAMESITE="lax"

# --- 4. Private File Storage (MUST stay outside public_html) ------------------
UPLOAD_STORAGE_DIR="./storage/private_uploads"

# --- 5. Initial Administrator Bootstrap (created once on empty database) ------
INITIAL_ADMIN_EMAIL="admin@yourdomain.com"
INITIAL_ADMIN_PASSWORD="CHANGE_ME_STRONG_ADMIN_PASSWORD"

# --- 6. Outbound SMTP Notifications (Optional; also editable in Admin UI) -----
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Investor Relations <noreply@yourdomain.com>"
